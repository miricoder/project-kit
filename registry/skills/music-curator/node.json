{
  "kind": "skill",
  "name": "music-curator",
  "version": "0.1.0",
  "description": "Builds the music for a session: tempo band per section, running cadence, and a playlist from the connected service with timer ducking points.",
  "apps": [
    "pankra"
  ],
  "providers": {
    "claude": {
      "model": "claude-sonnet-5-5"
    },
    "gpt": {
      "model": "gpt-5"
    }
  },
  "requires": [
    "apiKey",
    "spotifyToken"
  ],
  "vision": false,
  "tools": [
    "profile.read",
    "sessions.read",
    "music.search",
    "music.playlist"
  ],
  "input": {
    "type": "object",
    "properties": {
      "sessionId": {
        "type": "string"
      }
    },
    "required": [
      "sessionId"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "tempoPlan": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "section": {
              "type": "string"
            },
            "bpm": {
              "type": "string"
            }
          }
        }
      },
      "playlistId": {
        "type": "string"
      },
      "cues": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "tempoPlan"
    ]
  }
}
